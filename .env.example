# ==============================================================================
# ABSA Studio - Environment Configuration Template
# Place in web/.env.local for local development, or configure in Vercel settings.
# All variables here are server-side only. NEVER prefix with NEXT_PUBLIC_
# ==============================================================================

# Supabase (Project Settings -> API -> Project URL & service_role secret)
# CAUTION: Never expose SUPABASE_SERVICE_ROLE_KEY to client-side code!
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Hugging Face Inference Space (ZeroGPU)
HF_SPACE_URL=https://your-username-absa-inference.hf.space
HF_API_SECRET=your-random-shared-secret-matching-space-api-secret

# Admin Console Access Control
# Set a strong, unique administrative passkey
ADMIN_PASSKEY=your-long-secure-random-admin-passkey
# 32+ character random string used to HMAC-sign session cookies (e.g. openssl rand -hex 32)
ADMIN_COOKIE_SECRET=your-32-byte-minimum-secret-signing-key
# Administrative account email for sign-in verification
ADMIN_EMAIL=admin@example.com

# Twitter Scraping via FetchLayer (Optional server-wide fallback default)
FETCHLAYER_API_KEY=
FETCHLAYER_BASE_URL=https://api.fetchlayer.dev
